{
  "manifest_version": 3,
  "name": "PassGuard — Password Generator",
  "version": "1.0.0",
  "description": "Generate, check, and securely save unique passwords for websites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ],
  "action": {
    "default_title": "PassGuard",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
